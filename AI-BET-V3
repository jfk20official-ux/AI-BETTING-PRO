# ==========================================================
# TEAM RATING ENGINE
# ==========================================================

def get_team_rating(team):

    """
    Moteur temporaire.
    Sera remplacé par:
    - classement API
    - historique matchs
    - forme réelle
    """

    value = sum(
        ord(x)
        for x in team
    )

    np.random.seed(value)

    elo = np.random.randint(
        1200,
        1800
    )

    attack = np.random.uniform(
        0.8,
        2.5
    )

    defense = np.random.uniform(
        0.8,
        2.0
    )


    return {

        "elo": elo,

        "attack": attack,

        "defense": defense

    }



# ==========================================================
# ELO ADVANTAGE
# ==========================================================

def elo_difference(home, away):


    home_data = get_team_rating(
        home
    )

    away_data = get_team_rating(
        away
    )


    diff = (
        home_data["elo"]
        -
        away_data["elo"]
    )


    advantage = diff / 400


    return advantage



# ==========================================================
# AI GOAL EXPECTED MODEL
# ==========================================================

def expected_goals(home, away):


    h = get_team_rating(
        home
    )

    a = get_team_rating(
        away
    )


    elo_bonus = elo_difference(
        home,
        away
    )



    home_xg = (

        h["attack"]
        *
        (2 - a["defense"]/2)

        +

        elo_bonus*0.15

    )



    away_xg = (

        a["attack"]
        *
        (2 - h["defense"]/2)

    )



    home_xg = max(
        0.2,
        min(home_xg,4)
    )


    away_xg = max(
        0.2,
        min(away_xg,4)
    )


    return (
        home_xg,
        away_xg
    )



# ==========================================================
# COMPLETE PREDICTION ENGINE
# ==========================================================

def predict_match(home, away):


    home_xg, away_xg = expected_goals(
        home,
        away
    )


    limit = 6


    matrix = np.outer(

        poisson.pmf(
            np.arange(limit+1),
            home_xg
        ),

        poisson.pmf(
            np.arange(limit+1),
            away_xg
        )

    )



    # 1 X 2

    p_home = (
        np.tril(matrix,-1)
        .sum()*100
    )


    p_draw = (
        np.diag(matrix)
        .sum()*100
    )


    p_away = (
        np.triu(matrix,1)
        .sum()*100
    )



    # SCORE EXACT

    best = np.unravel_index(

        np.argmax(matrix),

        matrix.shape

    )


    score = (
        f"{best[0]}-{best[1]}"
    )



    # OVER 2.5

    under = 0

    for i in range(3):

        for j in range(3-i):

            under += matrix[i][j]


    over25 = (
        1-under
    )*100



    # BTTS

    btts = (

        1

        -
        matrix[0,:].sum()

        -
        matrix[:,0].sum()

        +
        matrix[0,0]

    )*100



    confidence = max(

        p_home,

        p_draw,

        p_away

    )



    return {


        "score":score,


        "home":round(
            p_home,
            1
        ),


        "draw":round(
            p_draw,
            1
        ),


        "away":round(
            p_away,
            1
        ),


        "over25":round(
            over25,
            1
        ),


        "btts":round(
            btts,
            1
        ),


        "confidence":round(
            confidence,
            1
        ),


        "xg":

        f"{home_xg:.2f} - {away_xg:.2f}"

    }



