@st.cache_data(ttl=120)
def get_matches(date):

    if not API_KEY:
        return []


    url = (
        "https://v3.football.api-sports.io/"
        f"fixtures?date={date}"
    )


    headers = {

    "x-rapidapi-key":API_KEY,

    "x-rapidapi-host":
    "v3.football.api-sports.io"

    }


    try:

        r=requests.get(
            url,
            headers=headers,
            timeout=10
        )

        data=r.json()

        return data.get(
            "response",
            []
        )


    except:

        return []



