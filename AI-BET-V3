def get_signal(confidence):


    if confidence >= 70:

        return (
            "🔥 SAFE PICK",
            "safe"
        )


    elif confidence >=55:

        return (
            "⚠️ MEDIUM",
            "safe"
        )


    else:

        return (
            "❌ RISK",
            "risk"
        )


