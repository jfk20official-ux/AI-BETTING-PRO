# ==========================================================
# VALUE BET ENGINE
# ==========================================================

def calculate_value(probability, odd):


    if odd is None or odd <= 0:

        return {

            "status": False,

            "text":
            "Cote indisponible"

        }


    expected_return = (

        probability / 100

    ) * odd



    if expected_return > 1.05:

        return {

            "status": True,

            "text":
            f"💰 VALUE +{round((expected_return-1)*100,1)}%"

        }


    return {

        "status": False,

        "text":
        "Pas de value"

    }



# ==========================================================
# MARKET ANALYSIS
# ==========================================================

def market_analysis(data):


    markets = []


    if data["over25"] >= 60:

        markets.append(
            "⚽ Over 2.5"
        )


    if data["btts"] >= 60:

        markets.append(
            "🤝 BTTS YES"
        )


    if data["home"] >= 60:

        markets.append(
            "🏠 Home Win"
        )


    if data["away"] >=60:

        markets.append(
            "✈️ Away Win"
        )


    if not markets:

        markets.append(
            "⚖️ Match équilibré"
        )


    return markets



# ==========================================================
# TOP PICKS ENGINE
# ==========================================================

def generate_top_picks(matches):


    results=[]


    for match in matches:


        home = (
            match["teams"]
            ["home"]
            ["name"]
        )


        away = (
            match["teams"]
            ["away"]
            ["name"]
        )


        prediction = predict_match(
            home,
            away
        )


        results.append({

            "home":home,

            "away":away,

            "prediction":prediction

        })



    results.sort(

        key=lambda x:

        x["prediction"]
        ["confidence"],

        reverse=True

    )


    return results[:5]



